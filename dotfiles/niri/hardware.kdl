// ~/dot27/dotfiles/niri/hardware.kdl

output "eDP-1" {
    scale 1.8 // adjust the scale if the UI does not work right 
}

input {
    warp-mouse-to-focus
    keyboard {
        xkb { layout "us"; }
    }
    touchpad {
        tap
        natural-scroll
    }
}

cursor {
    hide-after-inactive-ms 3000
}
