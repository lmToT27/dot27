spawn-at-startup "swaybg" "-i" "/home/lmtot27/Pictures/Wallpapers/spiderman.jpg" "-m" "fill"
spawn-at-startup "waybar"
spawn-at-startup "swaync"

hotkey-overlay {
    skip-at-startup
}

input {
    focus-follows-mouse
    warp-mouse-to-focus
    keyboard {
        xkb { layout "us"; }
    }
    touchpad {
        tap
        natural-scroll
    }
}

cursor {
    hide-after-inactive-ms 3000
}

layout {
    gaps 12
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        on
        width 3
        active-color "#c0c0c0"
    }
}

prefer-no-csd   

window-rule {
    opacity 0.9
}

window-rule {
    match is-active=false
    opacity 0.8
}

window-rule {
    match app-id=r#".*"#

    background-effect {
        xray true
        blur true
        noise 0.05
        saturation 2
    }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^brave-browser$"#
    opacity 1.0
}

window-rule {
    match app-id=r#"^brave-browser$"#
    match app-id=r#"^spotify$"#
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id=r#"^xdg-desktop-portal.*"#
    match app-id=r#"^thunar$"# title="^File Operation Progress$"
    match title="^Open File$"
    match title="^Save File$"
    open-floating true
}


animations {
    on
    slowdown 2.0

    window-open {
        duration-ms 120
        curve "ease-out-quad"
        custom-shader r"
            vec4 open_circular_iris_tl(vec3 coords_geo, vec3 size_geo) {
                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec2 uv = coords_tex.st;
                
                float p = niri_clamped_progress;
                
                vec2 center = vec2(0.0, 0.0);
                
                vec2 aspect_uv = uv - center;
                aspect_uv.x *= size_geo.x / max(size_geo.y, 1.0);
                
                float dist = length(aspect_uv);
                
                float max_radius = length(vec2(1.0 * (size_geo.x / max(size_geo.y, 1.0)), 1.0));
                float current_radius = max_radius * p;
                
                float feather = 0.03;
                
                if (dist > current_radius) {
                    return vec4(0.0);
                }
                
                vec4 color = texture2D(niri_tex, uv);
                
                float alpha = smoothstep(current_radius, current_radius - feather, dist);
                color *= alpha;
                
                color *= smoothstep(0.0, 0.2, p);
                
                return color;
            }

            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                return open_circular_iris_tl(coords_geo, size_geo);
            }
        "
    }

    /-window-open {
        duration-ms 120
        curve "ease-out-quad"
        custom-shader r"
            vec4 open_circular_iris(vec3 coords_geo, vec3 size_geo) {
                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec2 uv = coords_tex.st;
                
                float p = niri_clamped_progress;
                
                vec2 center = vec2(0.5, 0.5);
                
                vec2 aspect_uv = uv - center;
                aspect_uv.x *= size_geo.x / max(size_geo.y, 1.0);
                
                float dist = length(aspect_uv);
                
                float max_radius = length(vec2(0.5 * (size_geo.x / max(size_geo.y, 1.0)), 0.5));
                float current_radius = max_radius * p;
                
                float feather = 0.03;
                
                if (dist > current_radius) {
                    return vec4(0.0);
                }
                
                vec4 color = texture2D(niri_tex, uv);
                
                float alpha = smoothstep(current_radius, current_radius - feather, dist);
                color *= alpha;
                
                color *= smoothstep(0.0, 0.2, p);
                
                return color;
            }

            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                return open_circular_iris(coords_geo, size_geo);
            }
        "
    }

    window-close {
        duration-ms 120
        curve "ease-out-quad"
        custom-shader r"
            vec4 close_circular_iris_tl(vec3 coords_geo, vec3 size_geo) {
                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec2 uv = coords_tex.st;
                
                float p = niri_clamped_progress;
                
                vec2 center = vec2(0.0, 0.0);
                
                vec2 aspect_uv = uv - center;
                aspect_uv.x *= size_geo.x / max(size_geo.y, 1.0);
                
                float dist = length(aspect_uv);
                
                float max_radius = length(vec2(1.0 * (size_geo.x / max(size_geo.y, 1.0)), 1.0));
                float current_radius = max_radius * (1.0 - p);
                
                float feather = 0.03;

                if (dist > current_radius) {
                    return vec4(0.0);
                }
                
                vec4 color = texture2D(niri_tex, uv);
                
                float alpha = smoothstep(current_radius, current_radius - feather, dist);
                color *= alpha;
                
                color *= smoothstep(1.0, 0.8, p);
                
                return color;
            }

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                return close_circular_iris_tl(coords_geo, size_geo);
            }
        "
    }

    /-window-close {
        duration-ms 120
        curve "ease-out-quad"
        custom-shader r"
            vec4 close_circular_iris(vec3 coords_geo, vec3 size_geo) {
                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec2 uv = coords_tex.st;
                
                float p = niri_clamped_progress;
                
                vec2 center = vec2(0.5, 0.5);
                
                vec2 aspect_uv = uv - center;
                aspect_uv.x *= size_geo.x / max(size_geo.y, 1.0);
                
                float dist = length(aspect_uv);
                
                float max_radius = length(vec2(0.5 * (size_geo.x / max(size_geo.y, 1.0)), 0.5));
                float current_radius = max_radius * (1.0 - p);
                
                float feather = 0.03;

                if (dist > current_radius) {
                    return vec4(0.0);
                }
                
                vec4 color = texture2D(niri_tex, uv);
                
                float alpha = smoothstep(current_radius, current_radius - feather, dist);
                color *= alpha;
                
                color *= smoothstep(1.0, 0.8, p);
                
                return color;
            }

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                return close_circular_iris(coords_geo, size_geo);
            }
        "
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.6 stiffness=500 epsilon=0.01
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }

    workspace-switch {
        spring damping-ratio=1.2 stiffness=1000 epsilon=0.0001
    }
}

binds {
    Mod+T { spawn "kitty"; }
    Mod+W { spawn "brave"; }
    Mod+E { spawn "thunar"; }
    Mod+S { spawn "spotify"; }
    Mod+Return { spawn "rofi" "-show" "drun"; }

    Mod+F { toggle-window-floating; }
    Mod+Q { close-window; }
    Mod+M { quit; }

    Mod+left { focus-column-left; }
    Mod+right { focus-column-right; }

    Mod+Shift+left { move-column-left; }
    Mod+Shift+right { move-column-right; }
    Mod+Shift+up { move-column-to-workspace-up; }
    Mod+Shift+down { move-column-to-workspace-down; }
    Mod+down { focus-workspace-down; }
    Mod+up { focus-workspace-up; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPause       allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    Mod+Tab repeat=false { toggle-overview; }
}

