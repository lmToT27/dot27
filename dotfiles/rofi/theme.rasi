// Mirrors the Quickshell floating-pill look (see AppLauncherWindow.qml).
// @accent, @bg-base, @fg, @bg-hover, @placeholder from colors.rasi
// (mode-aware, written by changetheme.sh).
@import "~/.cache/theme/colors.rasi"

* {
    border-color:   #333333;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    width:            520px;
    border-radius:    20px;
    border:           0px;
    background-color: @bg-base;
    padding:          16px;
    location:         center;
    anchor:           center;
}

mainbox {
    spacing: 12px;
}

inputbar {
    background-color: @bg-hover;
    border-radius:    12px;
    padding:          10px 14px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:     @accent;
    font:           "JetBrainsMono Nerd Font Bold 12";
    vertical-align: 0.5;
}

entry {
    placeholder:       "Search...";
    placeholder-color: @placeholder;
    cursor:            text;
    vertical-align:    0.5;
}

listview {
    lines:         6;
    spacing:       8px;
    scrollbar:     false;
    border:        0px;
    require-input: false;
}

element {
    padding:       8px 12px;
    border-radius: 12px;
    spacing:       16px;
    cursor:        pointer;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @bg-hover;
    text-color:       @accent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    highlight:        @accent;
}

element-icon {
    background-color: transparent;
    size:             48px;
    vertical-align:   0.5;
}
